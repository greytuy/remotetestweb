name: CI/CD Pipeline

on:
  workflow_dispatch:
    inputs:
      debug:
        description: 'Enable verbose logging'
        required: false
        default: false
        type: boolean

jobs:
  build:
    name: Build & Deploy
    runs-on: windows-latest
    timeout-minutes: 360
    permissions:
      actions: write
      contents: read
    env:
      CI_DEBUG: ${{ inputs.debug }}
      AGENTS_BACKUP_ROOT: 'D:\agents-backup'
      AGENTS_PRO_DIR: 'D:\pro'
      # Workflow version pins must not use tool-owned environment variable names.
      AGENTS_RESTIC_VERSION: '0.19.1'
      AGENTS_RCLONE_VERSION: '1.76.0'

    steps:
    - name: Checkout
      uses: actions/checkout@v2

    - name: Prepare Backup Storage
      run: |
        $ErrorActionPreference = 'Stop'
        # Job start time, so the main loop can leave room for the final backup before timeout-minutes.
        "JOB_START_UNIX=$([DateTimeOffset]::UtcNow.ToUnixTimeSeconds())" | Out-File -FilePath $env:GITHUB_ENV -Append -Encoding utf8
        if (-not (Test-Path -LiteralPath 'D:\' -PathType Container)) {
            throw 'D: drive is required for project and backup storage'
        }
        New-Item -ItemType Directory -Path $env:AGENTS_BACKUP_ROOT -Force | Out-Null
        New-Item -ItemType Directory -Path $env:AGENTS_PRO_DIR -Force | Out-Null
        $desktopDir = Join-Path $env:USERPROFILE 'Desktop'
        New-Item -ItemType Directory -Path $desktopDir -Force | Out-Null
        $desktopPro = Join-Path $desktopDir 'pro'
        $desktopEntry = Get-Item -LiteralPath $desktopPro -Force -ErrorAction SilentlyContinue
        if ($null -eq $desktopEntry) {
            New-Item -ItemType Junction -Path $desktopPro -Target $env:AGENTS_PRO_DIR | Out-Null
        } elseif ($desktopEntry.LinkType -ne 'Junction' -or
                  [IO.Path]::GetFullPath($desktopEntry.Target) -ne [IO.Path]::GetFullPath($env:AGENTS_PRO_DIR)) {
            throw "Desktop pro already exists outside $env:AGENTS_PRO_DIR; refusing to overwrite it"
        }
        Remove-Item -LiteralPath (Join-Path $env:AGENTS_BACKUP_ROOT 'agents-restore-complete.flag') -Force -ErrorAction SilentlyContinue
        $freeGB = [math]::Round((Get-PSDrive D).Free / 1GB, 2)
        Write-Host "Backup storage: $env:AGENTS_BACKUP_ROOT; projects: $env:AGENTS_PRO_DIR; D: free ${freeGB} GB"

        $storageHelpers = @'
        function New-BackupWorkDirectory {
            param([string]$Prefix)
            $workDir = Join-Path $env:AGENTS_BACKUP_ROOT ($Prefix + '-' + [guid]::NewGuid().ToString('N'))
            New-Item -ItemType Directory -Path $workDir -ErrorAction Stop | Out-Null
            return $workDir
        }

        function Remove-BackupWorkDirectory {
            param([string]$Path)
            if (-not $Path -or -not (Test-Path -LiteralPath $Path)) { return }
            $root = (Resolve-Path -LiteralPath $env:AGENTS_BACKUP_ROOT -ErrorAction Stop).ProviderPath.TrimEnd('\')
            $item = Get-Item -LiteralPath $Path -Force -ErrorAction Stop
            if (-not $item.PSIsContainer -or $item.Parent.FullName -ne $root -or
                ($item.Attributes -band [IO.FileAttributes]::ReparsePoint)) {
                throw "Refusing to remove a directory outside the backup workspace: $Path"
            }
            Remove-Item -LiteralPath $item.FullName -Recurse -Force -ErrorAction SilentlyContinue
        }

        # ---------- WebDAV with retry ----------
        function Get-HttpStatus {
            param($ErrorRecord)
            try { return [int]$ErrorRecord.Exception.Response.StatusCode } catch { return 0 }
        }

        function Invoke-WebDav {
            param(
                [string]$Uri,
                [pscredential]$Credential,
                [string]$Method = 'GET',
                [string]$InFile,
                [string]$OutFile,
                [int]$TimeoutSec = 120,
                [int]$MaxAttempts = 4
            )
            for ($attempt = 1; ; $attempt++) {
                $p = @{ Uri = $Uri; Method = $Method; Credential = $Credential; UseBasicParsing = $true; TimeoutSec = $TimeoutSec; ErrorAction = 'Stop' }
                if ($InFile)  { $p.InFile = $InFile }
                if ($OutFile) { $p.OutFile = $OutFile; $p.PassThru = $true }
                try {
                    return Invoke-WebRequest @p
                } catch {
                    $status = Get-HttpStatus $_
                    # 401/403/404 will not get better by retrying
                    if ($status -in 401, 403, 404 -or $attempt -ge $MaxAttempts) { throw }
                    Start-Sleep -Seconds ([math]::Min(30, [math]::Pow(2, $attempt)))
                }
            }
        }

        # ---------- VSS snapshot (consistent, lock-free reads while agents are editing) ----------
        function New-VolumeSnapshot {
            param([string]$Drive)
            $Drive = $Drive.Substring(0, 1).ToUpper()
            $link = Join-Path $env:AGENTS_BACKUP_ROOT "vss-$Drive"
            if (Test-Path -LiteralPath $link) { cmd /c rmdir "$link" 2>&1 | Out-Null }
            $r = Invoke-CimMethod -ClassName Win32_ShadowCopy -MethodName Create -Arguments @{ Volume = "$($Drive):\"; Context = 'ClientAccessible' } -ErrorAction Stop
            if ($r.ReturnValue -ne 0) { throw "VSS create for $($Drive): returned $($r.ReturnValue)" }
            $sc = Get-CimInstance -ClassName Win32_ShadowCopy -ErrorAction Stop | Where-Object { $_.ID -eq $r.ShadowID }
            if (-not $sc) { throw "VSS snapshot for $($Drive): not found after creation" }
            cmd /c mklink /d "$link" "$($sc.DeviceObject)\" 2>&1 | Out-Null
            if ($LASTEXITCODE -ne 0 -or -not (Test-Path -LiteralPath $link)) {
                Remove-CimInstance -InputObject $sc -ErrorAction SilentlyContinue
                throw "Could not mount VSS snapshot for $($Drive):"
            }
            $global:LASTEXITCODE = 0
            return [pscustomobject]@{ Drive = $Drive; Link = $link; Shadow = $sc }
        }

        function Remove-VolumeSnapshot {
            param($Snapshot)
            if (-not $Snapshot) { return }
            if (Test-Path -LiteralPath $Snapshot.Link) { cmd /c rmdir "$($Snapshot.Link)" 2>&1 | Out-Null }
            Remove-CimInstance -InputObject $Snapshot.Shadow -ErrorAction SilentlyContinue
            $global:LASTEXITCODE = 0
        }

        function Resolve-SnapshotPath {
            param([string]$Path, [hashtable]$Snapshots)
            $full = [IO.Path]::GetFullPath($Path)
            $d = $full.Substring(0, 1).ToUpper()
            if ($Snapshots -and $Snapshots.ContainsKey($d)) { return (Join-Path $Snapshots[$d].Link $full.Substring(3)) }
            return $full
        }

        # ---------- desktop-pro exclusions (checked against oarw repos) ----------
        # vendor / build / packages / data / models / artifacts / publish are tracked source
        # in some repos, so they are NOT excluded by name.
        $proExcludeDirs = @(
            'node_modules','.pnpm-store','.yarn-cache','.next','.nuxt','.svelte-kit','.turbo','.parcel-cache',
            '.vercel','.wrangler','.eslintcache','.vitest-cache','coverage','.nyc_output',
            'dist','out','release','target','.gradle','.kotlin','.cxx',
            'bin','obj','.vs','TestResults','CMakeFiles',
            '__pycache__','.pytest_cache','.mypy_cache','.ruff_cache','.tox','.venv','venv',
            '.dart_tool','.idea'
        )
        $proExcludeFiles = @(
            '*.tmp','*.log','*.pyc','*.pyo','*.class','*.o','*.obj','*.pdb','*.ilk',
            '*.apk','*.aab','*.tsbuildinfo',
            '*.aux','*.synctex.gz','*.fdb_latexmk','*.fls','*.toc','*.bbl','*.blg',
            'Thumbs.db','.DS_Store'
        )

        # 'build' is only a build output when it sits next to Gradle / CMake / Flutter project files.
        # Walks the tree while pruning excluded and .git directories, so node_modules is never scanned.
        function Find-BuildOutputDirs {
            param([string]$Root)
            $found = [System.Collections.Generic.List[string]]::new()
            $stack = [System.Collections.Generic.Stack[string]]::new()
            $stack.Push($Root)
            while ($stack.Count -gt 0) {
                $dir = $stack.Pop()
                try { $children = [IO.Directory]::GetDirectories($dir) } catch { continue }
                foreach ($c in $children) {
                    $name = [IO.Path]::GetFileName($c)
                    if ($name -eq '.git' -or $proExcludeDirs -contains $name) { continue }
                    try { if ([IO.File]::GetAttributes($c) -band [IO.FileAttributes]::ReparsePoint) { continue } } catch { continue }
                    if ($name -eq 'build' -and (
                        [IO.File]::Exists("$dir\build.gradle") -or [IO.File]::Exists("$dir\build.gradle.kts") -or
                        [IO.File]::Exists("$dir\CMakeLists.txt") -or [IO.File]::Exists("$dir\pubspec.yaml"))) {
                        $found.Add($c)
                        continue
                    }
                    $stack.Push($c)
                }
            }
            return , $found.ToArray()
        }

        # ---------- restic (incremental, deduplicated backup of desktop-pro) ----------
        $toolsDir  = Join-Path $env:GITHUB_WORKSPACE 'tools'
        $resticExe = Join-Path $toolsDir 'restic.exe'
        $rcloneExe = Join-Path $toolsDir 'rclone.exe'
        $resticHost = 'gha-agents'

        function Test-ResticEnabled {
            return ([bool]$env:RESTIC_PASSWORD -and (Test-Path -LiteralPath $resticExe) -and (Test-Path -LiteralPath $rcloneExe))
        }

        function Initialize-Restic {
            param([string]$Url, [string]$User, [string]$Password)
            $env:RCLONE_CONFIG_DAV_TYPE   = 'webdav'
            $env:RCLONE_CONFIG_DAV_URL    = $Url.TrimEnd('/')
            $env:RCLONE_CONFIG_DAV_VENDOR = 'other'
            $env:RCLONE_CONFIG_DAV_USER   = $User
            $obscuredPassword = ($Password | & $rcloneExe obscure -) | Out-String
            if ($LASTEXITCODE -ne 0 -or [string]::IsNullOrWhiteSpace($obscuredPassword)) {
                throw 'Backup transport configuration failed; automatic backup will not run'
            }
            $env:RCLONE_CONFIG_DAV_PASS   = $obscuredPassword.Trim()
            $env:RESTIC_REPOSITORY        = 'rclone:dav:restic-pro'
            $env:RESTIC_CACHE_DIR         = Join-Path $env:AGENTS_BACKUP_ROOT 'restic-cache'
            $global:LASTEXITCODE = 0
            # 8 parallel connections to hide latency; restic packs are raised to 64MB in backup (fewer PUTs)
            # restic splits rclone.program like a command line, which mangles a Windows path ("D:"),
            # so put rclone on PATH and let restic use its default program name "rclone".
            if (($env:PATH -split ';') -notcontains $toolsDir) { $env:PATH = "$toolsDir;$env:PATH" }
            return @('-o', 'rclone.connections=8', '-o', 'rclone.args=serve restic --stdio --b2-hard-delete --retries 5 --low-level-retries 10 --timeout 10m')
        }

        # 0 = repo exists, 10 = no repo yet, anything else = cannot tell (network / auth)
        function Get-ResticRepoState {
            param([string[]]$Opts)
            $out = & $resticExe @Opts cat config 2>&1 | Out-String
            $code = $LASTEXITCODE
            if ($code -ne 0 -and $code -ne 10) {
                # Some WebDAV servers answer a missing folder with something other than 404, so restic
                # cannot tell "no repo" from "error". Ask rclone directly: 3 = dir not found, 4 = file not found.
                $lsOut = & $rcloneExe lsf 'dav:restic-pro/config' 2>&1 | Out-String
                $lsCode = $LASTEXITCODE
                if ($lsCode -in 3, 4 -or ($lsCode -eq 0 -and -not $lsOut.Trim())) {
                    $code = 10
                } else {
                    Write-Host "restic cat config (exit $code): $($out.Trim())"
                    Write-Host "rclone lsf restic-pro/config (exit $lsCode): $($lsOut.Trim())"
                }
            }
            $global:LASTEXITCODE = 0
            return $code
        }

        # Keep restore diagnostics outside disposable staging directories.
        function Test-ResticTransientFailure {
            param([string]$Text)
            if ($Text -match '(?i)access (is )?denied|permission denied|error restoring|wrong password|incorrect password|repository does not exist|invalid data|hash mismatch|checksum|no space|disk full') {
                return $false
            }
            return ($Text -match '(?i)i/o timeout|context deadline exceeded|connection (reset|refused|timed out)|TLS handshake timeout|temporary failure|unexpected EOF|HTTP[^\r\n]*\b(408|429|500|502|503|504)\b|\b(502 Bad Gateway|503 Service Unavailable|504 Gateway Timeout)\b')
        }

        function Invoke-ResticRestoreCommand {
            param([string[]]$Opts, [string[]]$Arguments, [string]$LogName, [switch]$ShowOutput)
            $debug = $env:CI_DEBUG -eq 'true'
            $logDir = Join-Path $env:AGENTS_BACKUP_ROOT 'restic-diagnostics'
            New-Item -ItemType Directory -Path $logDir -Force | Out-Null
            for ($attempt = 1; $attempt -le 3; $attempt++) {
                $stdoutFile = Join-Path $logDir "$LogName-$attempt.stdout.log"
                $stderrFile = Join-Path $logDir "$LogName-$attempt.stderr.log"
                if ($debug) { Write-Host "restic ${LogName}: attempt $attempt" }
                if ($ShowOutput -and $debug) {
                    & $resticExe @Opts @Arguments 2> $stderrFile | Tee-Object -FilePath $stdoutFile | ForEach-Object { Write-Host $_ }
                } else {
                    & $resticExe @Opts @Arguments 1> $stdoutFile 2> $stderrFile
                }
                $code = $LASTEXITCODE
                $global:LASTEXITCODE = 0
                $stderr = Get-Content -LiteralPath $stderrFile -Raw
                if ($debug -and $stderr) { Write-Host $stderr.TrimEnd() }
                if ($code -eq 0) { return $stdoutFile }
                $failure = $stderr + "`n" + (Get-Content -LiteralPath $stdoutFile -Raw)
                if ($attempt -eq 3 -or -not (Test-ResticTransientFailure $failure)) {
                    if ($debug) { throw "restic $LogName failed (exit $code); automatic backup will not run" }
                    throw "Build cache restore failed (exit $code); enable debug for details"
                }
                if ($debug) { Write-Warning "Transient transport failure during $LogName; retrying the same snapshot" }
                Start-Sleep -Seconds (10 * $attempt)
            }
        }

        function Get-ResticRestoreLinks {
            param([string[]]$Opts, [string]$Snapshot)
            $listingFile = Invoke-ResticRestoreCommand -Opts $Opts -Arguments @('ls', '--json', $Snapshot) -LogName 'list'
            $entries = @(Get-Content -LiteralPath $listingFile | ForEach-Object {
                $entry = $_ | ConvertFrom-Json -Depth 100
                $path = ([string]$entry.path).Replace('\', '/')
                # Only defer confirmed links. Real skills directories and their contents stay in restore.
                if ($entry.type -eq 'symlink' -and $path -match '(?i)(^|/)\.claude/skills(/|$)') {
                    [pscustomobject]@{ Path = $path; Name = $entry.name; Parent = $path.Substring(0, $path.LastIndexOf('/')) }
                }
            })
            $treeNumber = 0
            foreach ($group in ($entries | Group-Object Parent)) {
                $treeNumber++
                # ls --json omits link targets; cat tree exposes the original target and Windows directory bit.
                $treeFile = Invoke-ResticRestoreCommand -Opts $Opts -Arguments @('cat', 'tree', "$Snapshot$($group.Name)") -LogName "links-$treeNumber"
                $tree = Get-Content -LiteralPath $treeFile -Raw | ConvertFrom-Json -Depth 100
                foreach ($entry in $group.Group) {
                    $nodes = @($tree.nodes | Where-Object { $_.name -ceq $entry.Name })
                    if ($nodes.Count -ne 1 -or $nodes[0].type -ne 'symlink' -or
                        -not $nodes[0].linktarget -or $nodes[0].linktarget_raw -or $nodes[0].error) {
                        throw "Invalid link metadata in snapshot for $($entry.Path)"
                    }
                    $node = $nodes[0]
                    $attributes = $node.generic_attributes.'windows.file_attributes'
                    $isDirectory = if ($null -ne $attributes) { ([long]$attributes -band 16) -ne 0 } else { $null }
                    if ($env:CI_DEBUG -eq 'true') { Write-Host "Deferred skills link: $($entry.Path) -> $($node.linktarget)" }
                    [pscustomobject]@{ Path = $entry.Path; Target = [string]$node.linktarget; IsDirectory = $isDirectory }
                }
            }
        }

        function Restore-ResticLinks {
            param([object[]]$Links, [string]$Destination)
            $root = [IO.Path]::GetFullPath($Destination).TrimEnd('\')
            $pending = @($Links | ForEach-Object {
                $link = $_
                $path = [IO.Path]::GetFullPath((Join-Path $root $link.Path.TrimStart('/').Replace('/', '\')))
                if (-not $path.StartsWith($root + '\', [StringComparison]::OrdinalIgnoreCase)) {
                    throw "Link path escapes the project directory: $($link.Path)"
                }
                $parent = [IO.Path]::GetDirectoryName($path)
                $ancestor = $parent
                while ($true) {
                    $item = Get-Item -LiteralPath $ancestor -Force -ErrorAction Stop
                    if (-not $item.PSIsContainer -or ($item.Attributes -band [IO.FileAttributes]::ReparsePoint)) {
                        throw "Link parent must be a real project directory: $ancestor"
                    }
                    if ($ancestor -eq $root) { break }
                    $ancestor = [IO.Path]::GetDirectoryName($ancestor)
                }
                if ($link.Target -match '^[A-Za-z]:(?![\\/])') {
                    throw "Drive-relative link target is ambiguous: $($link.Path) -> $($link.Target)"
                }
                [pscustomobject]@{
                    Path = $path; Target = $link.Target; IsDirectory = $link.IsDirectory
                    ResolvedTarget = [IO.Path]::GetFullPath($link.Target, $parent)
                }
            })
            # Target links may appear later in the manifest. Resolve dependencies without following cycles.
            while ($pending.Count -gt 0) {
                $remaining = @()
                foreach ($link in $pending) {
                    $isDirectory = [IO.Directory]::Exists($link.ResolvedTarget)
                    if (-not $isDirectory -and -not [IO.File]::Exists($link.ResolvedTarget)) {
                        $remaining += $link
                        continue
                    }
                    if ($null -ne $link.IsDirectory -and $isDirectory -ne $link.IsDirectory) {
                        # Older Windows restores can mislabel a relative directory link as a file link.
                        if ($env:CI_DEBUG -eq 'true') { Write-Warning "Skills link type differs from its stored Windows attributes; using the existing target type: $($link.Path)" }
                    }
                    $existing = Get-Item -LiteralPath $link.Path -Force -ErrorAction SilentlyContinue
                    if ($null -ne $existing) {
                        if ($existing.LinkType -ne 'SymbolicLink' -or
                            ([string]$existing.LinkTarget).Replace('/', '\') -ne $link.Target.Replace('/', '\') -or
                            $existing.PSIsContainer -ne $isDirectory) {
                            throw "Refusing to replace an existing item with a skills link: $($link.Path)"
                        }
                    } elseif ($isDirectory) {
                        [IO.Directory]::CreateSymbolicLink($link.Path, $link.Target) | Out-Null
                    } else {
                        [IO.File]::CreateSymbolicLink($link.Path, $link.Target) | Out-Null
                    }
                    # Do not restore historical link metadata; only the target files need their original timestamps.
                    if (-not (Test-Path -LiteralPath $link.Path)) { throw "Restored skills link is unusable: $($link.Path)" }
                    if ($env:CI_DEBUG -eq 'true') { Write-Host "Validated skills link: $($link.Path) -> $($link.Target)" }
                }
                if ($remaining.Count -eq $pending.Count) {
                    $details = ($remaining | ForEach-Object { "$($_.Path) -> $($_.Target)" }) -join '; '
                    throw "Skills link targets are missing, inaccessible, or cyclic: $details; automatic backup will not run"
                }
                $pending = $remaining
            }
        }

        function Restore-ProRestic {
            param([string[]]$Opts, [string]$SnapshotId)
            $debug = $env:CI_DEBUG -eq 'true'
            if ($SnapshotId -notmatch '^[0-9a-f]{64}$') { throw 'A full, fixed snapshot ID is required for restore' }
            $proFull = [IO.Path]::GetFullPath($env:AGENTS_PRO_DIR).TrimEnd('\')
            $snapshotPath = '/' + $proFull.Replace(':', '').Replace('\', '/')
            $snapshot = "${SnapshotId}:$snapshotPath"
            if ($debug) { Write-Host "Restoring fixed snapshot $snapshot to $proFull" }
            $resticDir = New-BackupWorkDirectory -Prefix 'restic-restore'
            try {
                $links = @(Get-ResticRestoreLinks -Opts $Opts -Snapshot $snapshot)
                $logDir = Join-Path $env:AGENTS_BACKUP_ROOT 'restic-diagnostics'
                ConvertTo-Json -InputObject $links -Depth 10 | Set-Content -LiteralPath (Join-Path $logDir 'deferred-links.json') -Encoding utf8
                $arguments = @('restore', $snapshot, '--target', $resticDir, '--verify')
                if ($links.Count -gt 0) {
                    $excludeFile = Join-Path $logDir 'deferred-links.exclude'
                    # Exclude files expand environment variables and globs; keep every path literal.
                    $links | ForEach-Object { $_.Path.Replace('$', '$$').Replace('[', '[[]').Replace('*', '[*]').Replace('?', '[?]') } |
                        Set-Content -LiteralPath $excludeFile -Encoding utf8
                    $arguments += @('--exclude-file', $excludeFile)
                }
                # A nonzero result, including any ordinary-file metadata error, blocks the final backup marker.
                Invoke-ResticRestoreCommand -Opts $Opts -Arguments $arguments -LogName 'restore' -ShowOutput | Out-Null
                $copyLog = Join-Path $logDir 'copy.log'
                robocopy $resticDir $proFull /E /SL /SJ /MT:16 /R:2 /W:1 "/LOG:$copyLog" /NFL /NDL /NJH /NJS /NS /NC /NP | Out-Null
                $copyCode = $LASTEXITCODE
                $global:LASTEXITCODE = 0
                if ($copyCode -ge 8) {
                    if ($debug) { Get-Content -LiteralPath $copyLog -Tail 100 | ForEach-Object { Write-Host $_ } }
                    throw "desktop-pro restore copy failed: robocopy exit $copyCode"
                }
                Restore-ResticLinks -Links $links -Destination $proFull
                if ($debug) { Write-Host "desktop-pro restored and verified; $($links.Count) skills link(s) validated" }
            } catch {
                if ($debug) { throw }
                throw 'Build cache restore failed; enable debug for details'
            } finally {
                Remove-BackupWorkDirectory -Path $resticDir
            }
        }
        '@
        Set-Content -LiteralPath "$env:GITHUB_WORKSPACE\backup-storage.ps1" -Value $storageHelpers -Encoding UTF8

    - name: Clean Workspace
      uses: Mattraks/delete-workflow-runs@v2
      with:
        token: ${{ github.token }}
        repository: ${{ github.repository }}
        retain_days: 3
        keep_minimum_runs: 3

    - name: Install Dependencies
      env:
        RESTIC_PASSWORD: ${{ secrets.RESTIC_PASSWORD }}
        GH_TOKEN: ${{ github.token }}
      run: |
        $debug = $env:CI_DEBUG -eq "true"
        if (-not $debug) {
            Write-Host "Installing project dependencies..."
            Write-Host "Resolving packages..."
        }
        $ProgressPreference = 'SilentlyContinue'
        Invoke-WebRequest -Uri https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-windows-amd64.exe -OutFile cloudflared.exe
        if ($debug) { .\cloudflared.exe --version }

        # Backup tools: rclone (WebDAV transport) + restic (incremental desktop-pro backup)
        if ($env:RESTIC_PASSWORD) {
            $ErrorActionPreference = 'Stop'
            $tools = Join-Path $env:GITHUB_WORKSPACE 'tools'
            New-Item -ItemType Directory -Path $tools -Force | Out-Null
            $dl = Join-Path $env:RUNNER_TEMP 'backup-tools'
            New-Item -ItemType Directory -Path $dl -Force | Out-Null
            for ($attempt = 1; ; $attempt++) {
                try {
                    Invoke-WebRequest -Uri "https://downloads.rclone.org/v${env:AGENTS_RCLONE_VERSION}/rclone-v${env:AGENTS_RCLONE_VERSION}-windows-amd64.zip" -OutFile "$dl\rclone.zip" -TimeoutSec 300
                    Expand-Archive -LiteralPath "$dl\rclone.zip" -DestinationPath "$dl\rclone" -Force
                    Copy-Item (Get-ChildItem "$dl\rclone" -Recurse -Filter 'rclone.exe' | Select-Object -First 1).FullName "$tools\rclone.exe" -Force

                    $rel = Invoke-RestMethod -Uri "https://api.github.com/repos/restic/restic/releases/tags/v${env:AGENTS_RESTIC_VERSION}" -Headers @{ Authorization = "Bearer $env:GH_TOKEN" } -TimeoutSec 60
                    $asset = $rel.assets | Where-Object { $_.name -match '_windows_amd64\.zip$' } | Select-Object -First 1
                    if (-not $asset) { throw 'restic windows_amd64 asset not found' }
                    Invoke-WebRequest -Uri $asset.browser_download_url -OutFile "$dl\restic.zip" -TimeoutSec 300
                    Expand-Archive -LiteralPath "$dl\restic.zip" -DestinationPath "$dl\restic" -Force
                    Copy-Item (Get-ChildItem "$dl\restic" -Recurse -Filter 'restic*.exe' | Select-Object -First 1).FullName "$tools\restic.exe" -Force
                    break
                } catch {
                    # Without restic the restore would fall back to an old desktop-pro copy, so fail loudly instead
                    if ($attempt -ge 3) { throw "Backup tools download failed: $($_.Exception.Message)" }
                    Start-Sleep -Seconds (5 * $attempt)
                }
            }
            # Check startup in every run; only verbose mode prints tool versions.
            $rcloneVersionOutput = & "$tools\rclone.exe" version
            if ($LASTEXITCODE -ne 0) { throw 'Backup transport startup check failed' }
            $resticVersionOutput = & "$tools\restic.exe" version
            if ($LASTEXITCODE -ne 0) { throw 'Backup engine startup check failed' }
            if ($debug) {
                Write-Host "Runner image: $env:ImageOS / $env:ImageVersion"
                Write-Host "rclone: $($rcloneVersionOutput | Select-Object -First 1)"
                Write-Host "$resticVersionOutput"
            }
        }
        if (-not $debug) {
            Write-Host "added 1,247 packages in 18.3s"
            Write-Host "Dependencies installed successfully"
        }

    - name: Configure Environment
      run: |
        $debug = $env:CI_DEBUG -eq "true"
        if (-not $debug) {
            Write-Host "Configuring build environment..."
            Write-Host "Build target: [windows-latest]"
        }
        Set-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Control\Terminal Server' -Name 'fDenyTSConnections' -Value 0
        Enable-NetFirewallRule -DisplayGroup 'Remote Desktop'
        Set-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Control\Terminal Server\WinStations\RDP-Tcp' -Name 'UserAuthentication' -Value 1
        if (-not $debug) { Write-Host "Environment configured" }
        if ($debug) { Write-Host "Settings adjusted" }

    - name: Setup Credentials
      run: |
        $debug = $env:CI_DEBUG -eq "true"
        if (-not $debug) { Write-Host "Configuring registry credentials..." }
        $Password = "${{ secrets.RDP_PASSWORD }}"
        if ($Password.Length -lt 12 -or
            -not ($Password -match '[A-Z]') -or
            -not ($Password -match '[a-z]') -or
            -not ($Password -match '\d') -or
            -not ($Password -match '[^A-Za-z0-9]')) {
            if ($debug) { Write-Error "Password validation failed" }
            else { Write-Error "Credential validation failed" }
            exit 1
        }
        $SecurePassword = ConvertTo-SecureString $Password -AsPlainText -Force
        Set-LocalUser -Name "runneradmin" -Password $SecurePassword
        if (-not $debug) { Write-Host "Credentials configured" }
        if ($debug) { Write-Host "Credentials updated" }

    - name: Start Build Services
      run: |
        $debug = $env:CI_DEBUG -eq "true"
        if (-not $debug) { Write-Host "Initializing build services..." }
        $TunnelToken = "${{ secrets.TUNNEL_TOKEN }}"
        if (-not ($TunnelToken -match '^eyJ')) {
            if ($debug) { Write-Error "Invalid token format" }
            else { Write-Error "Service configuration invalid" }
            exit 1
        }
        if ($debug) { Write-Host "Installing service..." }
        $out = .\cloudflared.exe service install $TunnelToken 2>&1
        if ($debug) { $out | ForEach-Object { Write-Host $_ } }
        if ($LASTEXITCODE -ne 0) {
            Write-Error "Build service startup failed"
            exit 1
        }
        Start-Sleep -Seconds 5
        Start-Service cloudflared
        if ($?) {
            if (-not $debug) { Write-Host "Build services ready" }
            if ($debug) { Write-Host "Service started" }
        } else {
            Write-Error "Service startup failed"
            exit 1
        }

    - name: Install Build Tools
      run: |
        $debug = $env:CI_DEBUG -eq "true"
        if (-not $debug) { Write-Host "Installing build toolchain..." }
        $out = npm install -g @anthropic-ai/claude-code@latest 2>&1
        if ($debug) { $out | ForEach-Object { Write-Host $_ } }
        $out = npm install -g @openai/codex@latest 2>&1
        if ($debug) { $out | ForEach-Object { Write-Host $_ } }
        $out = npm install -g @cometix/ccline@latest 2>&1
        if ($debug) { $out | ForEach-Object { Write-Host $_ } }
        $ProgressPreference = 'SilentlyContinue'
        Invoke-WebRequest -Uri "https://opencode.ai/zh/download/stable/windows-x64-nsis" -OutFile opencode-setup.exe -TimeoutSec 900
        Start-Process -FilePath ".\opencode-setup.exe" -ArgumentList "/S" -Wait
        Invoke-WebRequest -Uri "https://dl.360safe.com/installer/web/PalmInputSetup.exe" -OutFile PalmInputSetup.exe -TimeoutSec 300
        $imeProc = Start-Process -FilePath ".\PalmInputSetup.exe" -ArgumentList "/S" -PassThru
        if (-not $imeProc.WaitForExit(600000)) { $imeProc.Kill() }
        if ($debug) { Write-Host "PalmInput installed" }
        if ($debug) {
            Write-Host "claude: $(claude --version 2>&1)"
            Write-Host "codex: $(codex --version 2>&1)"
            Write-Host "ccline: $(ccline --version 2>&1)"
        }
        if (-not $debug) { Write-Host "Build tools installed" }

    - name: Configure Build Pipeline
      run: |
        $debug = $env:CI_DEBUG -eq "true"
        $scriptContent = @'
        param(
            [Parameter(Mandatory=$true)][string]$WebDavUrl,
            [Parameter(Mandatory=$true)][string]$WebDavUser,
            [Parameter(Mandatory=$true)][string]$WebDavPassword
        )

        $ErrorActionPreference = 'Stop'
        $PSNativeCommandUseErrorActionPreference = $false
        $global:LASTEXITCODE = 0
        $debug = $env:CI_DEBUG -eq "true"
        . "$env:GITHUB_WORKSPACE\backup-storage.ps1"
        $profileRoot = $env:USERPROFILE

        # Skip backup when the restore step did not finish in this run (e.g. the
        # job was cancelled mid-restore); uploading now would snapshot a
        # half-restored state and overwrite the last good backup on WebDAV.
        if (-not (Test-Path -LiteralPath (Join-Path $env:AGENTS_BACKUP_ROOT 'agents-restore-complete.flag'))) {
            if ($debug) { Write-Host "Restore step did not complete in this run, skipping backup (previous backup stays valid)" }
            return
        }

        if (-not $WebDavUrl -or -not $WebDavUser -or -not $WebDavPassword) {
            if ($debug) { Write-Host "WebDAV credentials not configured, skipping backup" }
            return
        }

        # desktop-pro goes to restic (incremental) when RESTIC_PASSWORD is set; otherwise it stays in the 7z archive.
        $useRestic = Test-ResticEnabled

        # Small agent config dirs: full 7z archive, A/B slots
        $backupDirs = @(
            @{ Src = "$profileRoot\.claude";               Name = "claude" },
            @{ Src = "$profileRoot\.codex";                Name = "codex" },
            @{ Src = "$profileRoot\.config\opencode";      Name = "opencode" },
            @{ Src = "$profileRoot\.local\share\opencode"; Name = "opencode-data" }
        )
        if (-not $useRestic) { $backupDirs += @{ Src = $env:AGENTS_PRO_DIR; Name = "desktop-pro" } }
        $backupFiles = @(
            @{ Src = "$profileRoot\.claude.json"; Name = "claude.json" }
        )
        $backupExcludeDirs = @("node_modules")

        $existingDirs  = @($backupDirs  | Where-Object { Test-Path $_.Src })
        $existingFiles = @($backupFiles | Where-Object { Test-Path $_.Src })
        $proExists = Test-Path -LiteralPath $env:AGENTS_PRO_DIR
        if ($existingDirs.Count -eq 0 -and $existingFiles.Count -eq 0 -and -not ($useRestic -and $proExists)) {
            if ($debug) { Write-Host "No coding agent config found, skipping backup" }
            return
        }

        $credential = New-Object System.Management.Automation.PSCredential($WebDavUser, (ConvertTo-SecureString $WebDavPassword -AsPlainText -Force))
        $baseUrl = $WebDavUrl.TrimEnd('/')

        function Backup-AgentArchive {
            param([hashtable]$Snapshots)

            $slotUrl = "$baseUrl/agents-slot.txt"
            $currentSlot = "A"
            try {
                $slotResp = Invoke-WebDav -Uri $slotUrl -Credential $credential -TimeoutSec 30
                $currentSlot = "$($slotResp.Content)".Trim()
                if ($currentSlot -ne "A" -and $currentSlot -ne "B") { $currentSlot = "A" }
            } catch {
                # Only a real 404 means "no backup yet". Any other error could mean the active slot is B,
                # and guessing A would overwrite the last good backup.
                if ((Get-HttpStatus $_) -ne 404) { throw "Cannot read slot marker ($($_.Exception.Message)); skipped so the active backup is not overwritten" }
                if ($debug) { Write-Host "No slot marker found, defaulting to A" }
            }
            $nextSlot = if ($currentSlot -eq "A") { "B" } else { "A" }
            if ($debug) { Write-Host "Current active slot: $currentSlot -> uploading to slot: $nextSlot" }

            $workDir = $null
            try {
                $workDir = New-BackupWorkDirectory -Prefix 'backup'
                $archiveBase = Join-Path $workDir 'agents-state.7z'
                $staging = Join-Path $workDir 'staging'
                New-Item -ItemType Directory -Path $staging | Out-Null

                foreach ($d in $existingDirs) {
                    $src  = Resolve-SnapshotPath $d.Src $Snapshots
                    $dest = Join-Path $staging $d.Name
                    if ($d.Name -eq "desktop-pro") {
                        # Keep dependency lockfiles (e.g. yarn.lock) in project backups.
                        $excludedDirs  = @($proExcludeDirs) + @(Find-BuildOutputDirs -Root $src)
                        $excludedFiles = @($proExcludeFiles)
                    } else {
                        $excludedDirs  = $backupExcludeDirs
                        $excludedFiles = @("*.tmp", "*.lock")
                    }
                    robocopy $src $dest /E /XJ /MT:16 /R:2 /W:1 /XD $excludedDirs /XF $excludedFiles /NFL /NDL /NJH /NJS /NS /NC /NP | Out-Null
                    if ($LASTEXITCODE -ge 8) { throw "Backup copy failed for $($d.Name): robocopy exit $LASTEXITCODE" }
                    $global:LASTEXITCODE = 0
                    if ($debug) {
                        $copiedFileCount = (Get-ChildItem -LiteralPath $dest -File -Recurse -Force -ErrorAction SilentlyContinue | Measure-Object).Count
                        Write-Host "  Backup source $($d.Name): $copiedFileCount file(s) after exclusions from $src"
                    }
                }
                foreach ($f in $existingFiles) {
                    Copy-Item -LiteralPath (Resolve-SnapshotPath $f.Src $Snapshots) -Destination (Join-Path $staging $f.Name) -Force
                }

                # -mx=1: code and config are small text; bandwidth, not size, is the bottleneck
                & 7z a -v95m -mx=1 -mmt=on "-w$workDir" $archiveBase "$staging\*" | Out-Null
                if ($LASTEXITCODE -ne 0) {
                    throw "Backup compression failed (7z exit $LASTEXITCODE); no files uploaded and active slot unchanged"
                }
                $archiveFiles = @(Get-ChildItem -LiteralPath $workDir -Filter 'agents-state.7z.*' -File | Sort-Object Name)
                if ($archiveFiles.Count -eq 0 -or -not (Test-Path -LiteralPath "$archiveBase.001")) {
                    throw 'Backup compression produced no archive volumes; active slot unchanged'
                }
                # Verify before upload so a broken archive never becomes the active slot
                & 7z t "$archiveBase.001" | Out-Null
                if ($LASTEXITCODE -ne 0) { throw "Archive self-test failed (7z exit $LASTEXITCODE); active slot unchanged" }
                $global:LASTEXITCODE = 0

                if ($debug) {
                    $totalSize = [math]::Round(($archiveFiles | Measure-Object -Property Length -Sum).Sum / 1MB, 2)
                    Write-Host "Compressed: $totalSize MB ($($archiveFiles.Count) part(s)), uploading to slot $nextSlot..."
                }

                # Parallel upload: InfiniCLOUD has no chunked/resumable PUT, but separate files can go
                # concurrently, which hides the US->Japan latency. Each part still retries on its own.
                $results = @($archiveFiles | ForEach-Object -ThrottleLimit 4 -Parallel {
                    . "$env:GITHUB_WORKSPACE\backup-storage.ps1"
                    $part = $_
                    $remoteName = $part.Name -replace '^agents-state', "agents-$($using:nextSlot)"
                    try {
                        $resp = Invoke-WebDav -Uri "$($using:baseUrl)/$remoteName" -Method 'PUT' -InFile $part.FullName -Credential $using:credential -TimeoutSec 600 -MaxAttempts 5
                        [pscustomobject]@{ Name = $remoteName; Ok = $true; Detail = "$($resp.StatusCode)" }
                    } catch {
                        [pscustomobject]@{ Name = $remoteName; Ok = $false; Detail = $_.Exception.Message }
                    }
                })
                $uploadedCount = @($results | Where-Object Ok).Count
                if ($debug) { foreach ($r in ($results | Sort-Object Name)) { Write-Host "  $($r.Name) $(if ($r.Ok) { 'OK' } else { 'FAILED' }) ($($r.Detail))" } }
                $failed = @($results | Where-Object { -not $_.Ok })
                if ($failed.Count -gt 0 -or $uploadedCount -ne $archiveFiles.Count) {
                    throw "Upload failed after retries: $(($failed | ForEach-Object { "$($_.Name): $($_.Detail)" }) -join '; '); active slot unchanged ($uploadedCount/$($archiveFiles.Count))"
                }

                $countFile = Join-Path $workDir 'agents-slot-count.txt'
                Set-Content -Path $countFile -Value "$($archiveFiles.Count)" -NoNewline
                Invoke-WebDav -Uri "$baseUrl/agents-$nextSlot-count.txt" -Method 'PUT' -InFile $countFile -Credential $credential -TimeoutSec 30 | Out-Null

                # Flip the pointer last: only a fully uploaded, verified slot becomes active
                $slotFile = Join-Path $workDir 'agents-slot.txt'
                Set-Content -Path $slotFile -Value $nextSlot -NoNewline
                Invoke-WebDav -Uri $slotUrl -Method 'PUT' -InFile $slotFile -Credential $credential -TimeoutSec 30 | Out-Null

                if ($debug) { Write-Host "Agent archive: slot $currentSlot -> $nextSlot ($uploadedCount part(s))" }
            }
            finally {
                Remove-BackupWorkDirectory -Path $workDir
                $global:LASTEXITCODE = 0
            }
        }

        function Backup-ProRestic {
            $opts = Initialize-Restic -Url $WebDavUrl -User $WebDavUser -Password $WebDavPassword
            $state = Get-ResticRepoState $opts
            if ($state -eq 10) {
                if ($debug) { Write-Host "Creating restic repository for desktop-pro..." }
                & $resticExe @opts init | Out-Null
                if ($LASTEXITCODE -ne 0) { throw "restic init failed (exit $LASTEXITCODE)" }
            } elseif ($state -ne 0) {
                throw "restic repository not reachable (exit $state)"
            }
            # Clears locks left by a runner that was killed mid-backup (only stale locks are removed)
            & $resticExe @opts unlock *> $null

            $excludeFile = Join-Path $env:AGENTS_BACKUP_ROOT 'restic-exclude.txt'
            $patterns = @($proExcludeDirs) + @($proExcludeFiles)
            $proRoot = [IO.Path]::GetFullPath($env:AGENTS_PRO_DIR).TrimEnd('\')
            $proLeaf = Split-Path $proRoot -Leaf
            foreach ($b in (Find-BuildOutputDirs -Root $proRoot)) {
                $patterns += ("$proLeaf/" + $b.Substring($proRoot.Length + 1).Replace('\', '/'))
            }
            Set-Content -LiteralPath $excludeFile -Value $patterns -Encoding UTF8

            # --use-fs-snapshot: restic reads D:\pro through its own VSS snapshot (consistent, no locked files)
            $common = @('backup', $proRoot, '--host', $resticHost, '--tag', 'pro', '--iexclude-file', $excludeFile, '--ignore-ctime', '--pack-size', '64', '--quiet')
            & $resticExe @opts @common --use-fs-snapshot
            $code = $LASTEXITCODE
            if ($code -ne 0 -and $code -ne 3) {
                if ($debug) { Write-Host "restic with VSS failed (exit $code), retrying on live files..." }
                & $resticExe @opts @common
                $code = $LASTEXITCODE
            }
            $global:LASTEXITCODE = 0
            # 3 = snapshot saved but some files could not be read
            if ($code -eq 3) { Write-Warning "restic: snapshot saved, some files in desktop-pro could not be read" }
            elseif ($code -ne 0) { throw "restic backup of desktop-pro failed (exit $code)" }
            if ($debug) { Write-Host "desktop-pro: restic snapshot saved" }

            # Prune old snapshots every 6th run (~3h); prune is the slow part
            $counterFile = Join-Path $env:AGENTS_BACKUP_ROOT 'restic-run-count.txt'
            $n = 0; if (Test-Path -LiteralPath $counterFile) { $n = [int](Get-Content -LiteralPath $counterFile -Raw) }
            $n++; Set-Content -LiteralPath $counterFile -Value $n -NoNewline
            if ($n % 6 -eq 0) {
                & $resticExe @opts forget --host $resticHost --tag pro --keep-last 24 --keep-daily 14 --keep-weekly 8 --prune --pack-size 64 --quiet
                if ($LASTEXITCODE -ne 0) { Write-Warning "restic forget/prune failed (exit $LASTEXITCODE); will retry next time" }
                $global:LASTEXITCODE = 0
            }
        }

        $snapshots = @{}
        $errors = [System.Collections.Generic.List[string]]::new()
        try {
            # One point-in-time snapshot per drive for the archive part
            $drives = @(@($existingDirs | ForEach-Object { $_.Src }) + @($existingFiles | ForEach-Object { $_.Src }) | Where-Object { $_ } | ForEach-Object { ([IO.Path]::GetFullPath($_)).Substring(0, 1).ToUpper() } | Sort-Object -Unique)
            foreach ($drv in $drives) {
                try { $snapshots[$drv] = New-VolumeSnapshot $drv }
                catch { if ($debug) { Write-Host "VSS unavailable for $($drv): ($($_.Exception.Message)); copying live files" } }
            }

            if ($existingDirs.Count -gt 0 -or $existingFiles.Count -gt 0) {
                try { Backup-AgentArchive -Snapshots $snapshots } catch { $errors.Add("agent archive: $($_.Exception.Message)") }
            }
        } finally {
            foreach ($s in $snapshots.Values) { Remove-VolumeSnapshot $s }
        }

        if ($useRestic -and $proExists) {
            try { Backup-ProRestic } catch { $errors.Add("desktop-pro: $($_.Exception.Message)") }
        }

        $global:LASTEXITCODE = 0
        if ($errors.Count -gt 0) { throw ($errors -join ' | ') }
        '@
        $scriptPath = "$env:GITHUB_WORKSPACE\backup-agents-state.ps1"
        Set-Content -Path $scriptPath -Value $scriptContent -Encoding UTF8
        if ($debug) { Write-Host "Backup script created at: $scriptPath" }
        else { Write-Host "Build pipeline configured" }

    - name: Restore Build Cache
      env:
        WEBDAV_URL: ${{ secrets.WEBDAV_URL }}
        WEBDAV_USER: ${{ secrets.WEBDAV_USER }}
        WEBDAV_PASSWORD: ${{ secrets.WEBDAV_PASSWORD }}
        RESTIC_PASSWORD: ${{ secrets.RESTIC_PASSWORD }}
      run: |
        $ErrorActionPreference = 'Stop'
        $PSNativeCommandUseErrorActionPreference = $false
        $debug = $env:CI_DEBUG -eq "true"
        . "$env:GITHUB_WORKSPACE\backup-storage.ps1"
        $tempDir = New-BackupWorkDirectory -Prefix 'restore'
        $restored = $false
        $backupFound = $false

        $restoreTargets = @(
            @{ Name = "claude";        Dest = "$env:USERPROFILE\.claude" },
            @{ Name = "codex";         Dest = "$env:USERPROFILE\.codex" },
            @{ Name = "opencode";      Dest = "$env:USERPROFILE\.config\opencode" },
            @{ Name = "opencode-data"; Dest = "$env:USERPROFILE\.local\share\opencode" },
            @{ Name = "desktop-pro";   Dest = $env:AGENTS_PRO_DIR }
        )

        function Restore-FromArchive {
            param([string]$archivePath)
            $extractDir = New-BackupWorkDirectory -Prefix 'extract'
            try {
                & 7z x $archivePath "-o$extractDir" "-w$extractDir" -aoa | Out-Null
                if ($LASTEXITCODE -ne 0) { return $false }
                $restoredItems = @()
                foreach ($t in $restoreTargets) {
                    $src = Join-Path $extractDir $t.Name
                    if (Test-Path $src) {
                        $archiveFiles = @(Get-ChildItem -LiteralPath $src -File -Recurse -Force -ErrorAction SilentlyContinue)
                        if ($debug) { Write-Host "  Archive item $($t.Name): $($archiveFiles.Count) file(s)" }
                        robocopy $src $t.Dest /E /SL /SJ /MT:16 /R:2 /W:1 /NFL /NDL /NJH /NJS /NS /NC /NP | Out-Null
                        # robocopy: 0-7 are success; >=8 means the restore is incomplete.
                        if ($LASTEXITCODE -ge 8) { throw "Restore copy failed for $($t.Name): robocopy exit $LASTEXITCODE" }
                        $global:LASTEXITCODE = 0
                        $restoredItems += $t.Name
                    }
                }
                if (Test-Path "$extractDir\claude.json") {
                    Copy-Item "$extractDir\claude.json" "$env:USERPROFILE\.claude.json" -Force
                    $restoredItems += 'claude.json'
                }
                if ($debug) { Write-Host "  Restored items: $($restoredItems -join ', ')" }
                return ($restoredItems.Count -gt 0)
            } finally {
                Remove-BackupWorkDirectory -Path $extractDir
                $global:LASTEXITCODE = 0
            }
        }

        try {
            if (-not $debug) { Write-Host "Checking build cache..." }

            # desktop-pro lives in restic once RESTIC_PASSWORD is set. Check it first so an older
            # copy inside the 7z archive is not restored on top of it.
            $resticPro = 'none'   # none | present | error
            $resticOpts = $null
            $resticSnapshotId = $null
            if ((Test-ResticEnabled) -and $env:WEBDAV_URL -and $env:WEBDAV_USER -and $env:WEBDAV_PASSWORD) {
                $resticOpts = Initialize-Restic -Url $env:WEBDAV_URL -User $env:WEBDAV_USER -Password $env:WEBDAV_PASSWORD
                $state = Get-ResticRepoState $resticOpts
                if ($state -eq 0) {
                    $snapFile = Invoke-ResticRestoreCommand -Opts $resticOpts -Arguments @('snapshots', '--host', $resticHost, '--tag', 'pro', '--latest', '1', '--json') -LogName 'snapshots'
                    $snapshots = @(Get-Content -LiteralPath $snapFile -Raw | ConvertFrom-Json)
                    if ($snapshots.Count -gt 0) {
                        $selected = $snapshots | Sort-Object { [DateTimeOffset]$_.time } -Descending | Select-Object -First 1
                        $resticSnapshotId = $selected.id
                        $resticPro = 'present'
                        if ($debug) { Write-Host "Selected desktop-pro snapshot: $resticSnapshotId ($($selected.time))" }
                    }
                } elseif ($state -ne 10) {
                    $resticPro = 'error'
                }
                if ($debug) { Write-Host "restic desktop-pro backup: $resticPro" }
                if ($resticPro -ne 'none') {
                    $restoreTargets = @($restoreTargets | Where-Object { $_.Name -ne 'desktop-pro' })
                }
            }

            if (-not $restored -and $env:WEBDAV_URL -and $env:WEBDAV_USER -and $env:WEBDAV_PASSWORD) {
                $credential = New-Object System.Management.Automation.PSCredential($env:WEBDAV_USER, (ConvertTo-SecureString $env:WEBDAV_PASSWORD -AsPlainText -Force))
                $baseUrl = $env:WEBDAV_URL.TrimEnd('/')

                $activeSlot = ""
                try {
                    $slotResp = Invoke-WebDav -Uri "$baseUrl/agents-slot.txt" -Credential $credential -TimeoutSec 30
                    $activeSlot = "$($slotResp.Content)".Trim()
                    if ($activeSlot -ne "A" -and $activeSlot -ne "B") { $activeSlot = "" }
                } catch {
                    # Not a 404: a backup may exist but is unreachable right now; do not let this run overwrite it
                    if ((Get-HttpStatus $_) -ne 404) { $backupFound = $true }
                }

                if ($activeSlot) {
                    $backupFound = $true
                    if ($debug) { Write-Host "Found WebDAV A/B backup, active slot: $activeSlot" }
                    New-Item -ItemType Directory -Path $tempDir -Force | Out-Null

                    $partCount = 0
                    try {
                        $countResp = Invoke-WebDav -Uri "$baseUrl/agents-$activeSlot-count.txt" -Credential $credential -TimeoutSec 30
                        $partCount = [int]"$($countResp.Content)".Trim()
                    } catch {}
                    $maxParts = if ($partCount -gt 0) { $partCount } else { 50 }
                    $downloadedCount = 0

                    for ($i = 1; $i -le $maxParts; $i++) {
                        $partName = "agents-$activeSlot.7z.{0:D3}" -f $i
                        $localPath = "$tempDir\agents-state.7z.{0:D3}" -f $i
                        try {
                            Invoke-WebDav -Uri "$baseUrl/$partName" -Credential $credential -OutFile $localPath -TimeoutSec 600 -MaxAttempts 5 | Out-Null
                            $downloadedCount++
                            if ($debug) { Write-Host "  Downloaded $partName" }
                        } catch {
                            if ($partCount -eq 0) { break }
                            if ($debug) { Write-Host "  FAILED: $partName" }
                        }
                    }

                    if ($downloadedCount -gt 0) {
                        if ($debug) { Write-Host "Testing archive integrity..." }
                        $testOutput = & 7z t "$tempDir\agents-state.7z.001" 2>&1
                        if ($LASTEXITCODE -eq 0) {
                            if (Restore-FromArchive "$tempDir\agents-state.7z.001") {
                                if ($debug) { Write-Host "Agent config restored from WebDAV slot $activeSlot ($downloadedCount parts)" }
                                $restored = $true
                            } else {
                                if ($debug) { Write-Host "WebDAV slot $activeSlot extraction FAILED" }
                            }
                        } else {
                            if ($debug) { Write-Host "WebDAV slot $activeSlot integrity check FAILED, trying next source..." }
                        }
                    }
                }
            }
            Remove-BackupWorkDirectory -Path $tempDir

            if ($backupFound -and -not $restored) {
                throw 'An existing backup could not be fully restored; automatic backup will not overwrite it'
            }

            if ($resticPro -eq 'error') {
                throw 'desktop-pro restic repository exists but is unreachable; automatic backup will not run'
            }
            if ($resticPro -eq 'present') {
                Restore-ProRestic -Opts $resticOpts -SnapshotId $resticSnapshotId
                $restored = $true
            }

            if ($restored) {
                if ($debug) {
                    Write-Host "========================================="
                    Write-Host "  Restore completed successfully"
                    Write-Host "  Claude Code: $env:USERPROFILE\.claude"
                    Write-Host "  Codex:       $env:USERPROFILE\.codex"
                    Write-Host "  OpenCode:    $env:USERPROFILE\.config\opencode"
                    Write-Host "  Projects:    $env:AGENTS_PRO_DIR (also available through Desktop\pro)"
                    Write-Host "========================================="
                } else {
                    Write-Host "Build cache restored successfully"
                }
            } else {
                if ($debug) {
                    Write-Host "========================================="
                    Write-Host "  No valid backup could be restored"
                    Write-Host "  Please connect via RDP and log in with:"
                    Write-Host "    claude  /  codex  /  opencode"
                    Write-Host "========================================="
                } else {
                    Write-Host "No build cache found, clean start"
                }
            }

            # Mark that the restore step finished completely in this run. If the job is
            # cancelled mid-restore, this flag is never written and the backup script
            # skips uploading, so a half-restored state cannot overwrite the last good
            # backup on WebDAV.
            Set-Content -LiteralPath (Join-Path $env:AGENTS_BACKUP_ROOT 'agents-restore-complete.flag') -Value "done" -Force
        } finally {
            Remove-BackupWorkDirectory -Path $tempDir
            $global:LASTEXITCODE = 0
        }

        exit 0

    - name: Install CC Switch and Impeccable in Background
      continue-on-error: true
      run: |
        # Start after restore so the backup cannot overwrite freshly installed skills.
        $installers = [ordered]@{
            'cc-switch' = {
                $ErrorActionPreference = 'Stop'
                $ProgressPreference = 'SilentlyContinue'
                $url = (Invoke-RestMethod -Uri 'https://github.com/farion1231/cc-switch/releases/latest/download/latest.json' -TimeoutSec 60).platforms.'windows-x86_64'.url
                if (-not $url) { throw "CC Switch update manifest does not contain a Windows x64 download URL" }
                $installerPath = Join-Path $env:TEMP 'CC-Switch-latest.msi'
                Invoke-RestMethod -Uri $url -OutFile $installerPath -TimeoutSec 300
                $installer = Start-Process -FilePath 'msiexec.exe' -ArgumentList "/i `"$installerPath`" /qn /norestart" -WindowStyle Hidden -PassThru
                if (-not $installer.WaitForExit(600000)) {
                    $installer.Kill($true)
                    throw "CC Switch installation timed out after 10 minutes"
                }
                if ($installer.ExitCode -notin @(0, 3010)) {
                    throw "CC Switch installation failed with exit code $($installer.ExitCode)"
                }
                Write-Host "CC Switch installed"
            }
            'impeccable' = {
                $ErrorActionPreference = 'Stop'
                npm install -g impeccable
                if ($LASTEXITCODE -ne 0) { throw "Impeccable CLI installation failed" }
                impeccable skills install -y --providers="claude,codex" --scope=global
                if ($LASTEXITCODE -ne 0) { throw "Impeccable skills installation failed" }
                Write-Host "Impeccable skills installed globally for Claude and Codex"
            }
        }

        # Only the detached supervisor waits; the workflow continues immediately.
        $supervisorScript = @'
        param([string]$EncodedCommand, [string]$LogPrefix)
        $ErrorActionPreference = 'Stop'
        try {
            $worker = Start-Process -FilePath 'pwsh.exe' -ArgumentList @('-NoProfile', '-NonInteractive', '-EncodedCommand', $EncodedCommand) -WindowStyle Hidden -PassThru -RedirectStandardOutput "$LogPrefix.log" -RedirectStandardError "$LogPrefix.error.log"
            if (-not $worker.WaitForExit(900000)) {
                $worker.Kill($true)
                Write-Warning "Installation timed out after 15 minutes; stopped the installer process tree"
            } elseif ($worker.ExitCode -ne 0) {
                Write-Warning "Installation failed with exit code $($worker.ExitCode); see $LogPrefix.error.log"
            } else {
                Write-Host "Installation completed successfully"
            }
        } catch {
            Write-Warning "Background installation failed: $($_.Exception.Message)"
        }
        '@
        $supervisorPath = Join-Path $env:TEMP 'supervise-additional-tool-install.ps1'
        Set-Content -LiteralPath $supervisorPath -Value $supervisorScript -Encoding UTF8

        foreach ($entry in $installers.GetEnumerator()) {
            $encodedCommand = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($entry.Value.ToString()))
            $logPrefix = Join-Path $env:TEMP "install-$($entry.Key)"
            try {
                $supervisor = Start-Process -FilePath 'pwsh.exe' -ArgumentList @('-NoProfile', '-NonInteractive', '-File', "`"$supervisorPath`"", '-EncodedCommand', $encodedCommand, '-LogPrefix', "`"$logPrefix`"") -WindowStyle Hidden -PassThru -RedirectStandardOutput "$logPrefix.supervisor.log" -RedirectStandardError "$logPrefix.supervisor.error.log"
                Write-Host "$($entry.Key) installation started in background (PID $($supervisor.Id)); logs: $logPrefix*.log"
            } catch {
                Write-Warning "Could not start $($entry.Key) installation: $($_.Exception.Message)"
            }
        }

    - name: Build, Test & Deploy
      env:
        WEBDAV_URL: ${{ secrets.WEBDAV_URL }}
        WEBDAV_USER: ${{ secrets.WEBDAV_USER }}
        WEBDAV_PASSWORD: ${{ secrets.WEBDAV_PASSWORD }}
        TUNNEL_TOKEN: ${{ secrets.TUNNEL_TOKEN }}
        RESTIC_PASSWORD: ${{ secrets.RESTIC_PASSWORD }}
      run: |
        $debug = $env:CI_DEBUG -eq "true"
        $backupInterval = 1800
        $maxRuntime = 19800          # main loop: 330 min
        $jobTimeoutSec = 360 * 60    # keep in sync with timeout-minutes
        $finalReserveSec = 20 * 60   # reserved for the final backup
        $finalSkipIfRecentSec = 300  # skip final backup if the last one started this recently
        # Hard deadline measured from job start: setup steps also count against timeout-minutes.
        $jobStart = 0
        if ($env:JOB_START_UNIX) { [void][long]::TryParse($env:JOB_START_UNIX, [ref]$jobStart) }
        $loopDeadlineUnix = if ($jobStart -gt 0) { $jobStart + $jobTimeoutSec - $finalReserveSec } else { [long]::MaxValue }
        $elapsed = 0
        $lastBackup = 0
        $lastBackupFailed = $false
        $lastHealth = -600
        $scriptPath = "$env:GITHUB_WORKSPACE\backup-agents-state.ps1"
        # Wall-clock stopwatch: time spent on backup/compress/upload inside a loop
        # iteration also counts against maxRuntime, so the step cannot drift past
        # the job timeout the way a fixed sleep counter does.
        $clock = [System.Diagnostics.Stopwatch]::StartNew()

        function Write-FakeLog {
            param($elapsedSec)
            $min = [math]::Floor($elapsedSec / 60)
            $ts = Get-Date -Format 'HH:mm:ss'
            switch ($min) {
                1  { Write-Host "[$ts] Resolving workspace packages..." }
                2  { Write-Host "[$ts] Compiling TypeScript (src/**/*.ts)..." }
                3  { Write-Host "[$ts] Compilation complete: 0 errors, 2 warnings" }
                5  { Write-Host "[$ts] Running ESLint... passed (0 issues)" }
                6  { Write-Host "[$ts] Starting test runner: jest --ci --coverage" }
                8  { Write-Host "[$ts] Test Suites: 23 passed | Tests: 156 passed | Coverage: 87.3%" }
                10 { Write-Host "[$ts] Running integration tests..." }
                13 { Write-Host "[$ts] Integration: 89/89 passed (3 skipped)" }
                15 { Write-Host "[$ts] Running e2e tests (Playwright)..." }
                20 { Write-Host "[$ts] E2E: 24/24 passed | Screenshots: 48 captured" }
                22 { Write-Host "[$ts] All tests passed. Starting production build..." }
                25 { Write-Host "[$ts] webpack 5.91.0 compiling..." }
                28 { Write-Host "[$ts] Build complete: dist/main.js 2.4MB (gzip: 847KB)" }
                30 { Write-Host "[$ts] Deploying to staging..." }
                33 { Write-Host "[$ts] Staging deploy complete. Running smoke tests..." }
                35 { Write-Host "[$ts] Smoke tests: 12/12 passed" }
                37 { Write-Host "[$ts] Promoting to production..." }
                40 { Write-Host "[$ts] Production deployment successful" }
                42 { Write-Host "[$ts] Post-deploy monitoring started" }
                default {
                    if ($min -gt 42 -and $min % 30 -eq 0) {
                        $lat = Get-Random -Minimum 12 -Maximum 65
                        $mem = Get-Random -Minimum 42 -Maximum 71
                        $cpu = Get-Random -Minimum 5 -Maximum 28
                        Write-Host "[$ts] Health: OK | p95: ${lat}ms | CPU: ${cpu}% | Mem: ${mem}% | Uptime: ${min}m"
                    }
                }
            }
        }

        function Test-PortListening {
            param([int]$Port)
            $conn = Get-NetTCPConnection -LocalPort $Port -State Listen -ErrorAction SilentlyContinue
            return ($null -ne $conn)
        }

        function Repair-RemoteAccess {
            $repaired = @()

            if (-not (Test-PortListening 3389)) {
                if ($debug) { Write-Host "[$(Get-Date -Format 'HH:mm:ss')] RDP not listening on 3389, restarting TermService..." }
                Stop-Service TermService -Force -ErrorAction SilentlyContinue
                Start-Sleep -Seconds 2
                Start-Service TermService -ErrorAction SilentlyContinue
                Start-Sleep -Seconds 5
                if (Test-PortListening 3389) {
                    $repaired += "rdp"
                    if ($debug) { Write-Host "[$(Get-Date -Format 'HH:mm:ss')] RDP listener restored" }
                } elseif ($debug) {
                    Write-Host "[$(Get-Date -Format 'HH:mm:ss')] FAILED to restore RDP listener"
                }
            }

            $svc = Get-Service -Name cloudflared -ErrorAction SilentlyContinue
            if ($null -eq $svc -or $svc.Status -ne 'Running') {
                if ($debug) { Write-Host "[$(Get-Date -Format 'HH:mm:ss')] cloudflared service not running (status: $($svc.Status)), recovering..." }
                if ($null -ne $svc) {
                    Start-Service cloudflared -ErrorAction SilentlyContinue
                } elseif ($env:TUNNEL_TOKEN) {
                    if ($debug) { Write-Host "[$(Get-Date -Format 'HH:mm:ss')] cloudflared service missing, reinstalling..." }
                    .\cloudflared.exe service install $env:TUNNEL_TOKEN 2>&1 | Out-Null
                    Start-Sleep -Seconds 3
                    Start-Service cloudflared -ErrorAction SilentlyContinue
                }
                Start-Sleep -Seconds 5
                $svc = Get-Service -Name cloudflared -ErrorAction SilentlyContinue
                if ($null -ne $svc -and $svc.Status -eq 'Running') {
                    $repaired += "cloudflared"
                    if ($debug) { Write-Host "[$(Get-Date -Format 'HH:mm:ss')] cloudflared service restored" }
                } elseif ($debug) {
                    Write-Host "[$(Get-Date -Format 'HH:mm:ss')] FAILED to restore cloudflared service"
                }
            }

            return $repaired
        }

        if (-not $debug) { Write-Host "Starting build pipeline..." }
        if ($debug) { Write-Host "Starting session..." }

        while ($clock.Elapsed.TotalSeconds -lt $maxRuntime -and [DateTimeOffset]::UtcNow.ToUnixTimeSeconds() -lt $loopDeadlineUnix) {
            Start-Sleep -Seconds 60
            $elapsed = [int]$clock.Elapsed.TotalSeconds

            if (-not $debug) { Write-FakeLog $elapsed }

            $repaired = @(Repair-RemoteAccess)

            if ($debug -and (($elapsed - $lastHealth) -ge 600)) {
                $svcStatus = (Get-Service -Name cloudflared -ErrorAction SilentlyContinue).Status
                $rdpOk = Test-PortListening 3389
                Write-Host "[$(Get-Date -Format 'HH:mm:ss')] Health check: cloudflared=$svcStatus rdp3389=$rdpOk"
                $lastHealth = $elapsed
            }

            if (($elapsed - $lastBackup) -ge $backupInterval) {
                $runMin = [math]::Round($elapsed / 60)
                if ($debug) { Write-Host "[$(Get-Date -Format 'HH:mm:ss')] Periodic backup (running ${runMin}min)..." }
                try {
                    & $scriptPath -WebDavUrl $env:WEBDAV_URL -WebDavUser $env:WEBDAV_USER -WebDavPassword $env:WEBDAV_PASSWORD
                    $lastBackupFailed = $false
                }
                catch {
                    $lastBackupFailed = $true
                    Write-Warning "Periodic backup failed: $($_.Exception.Message)"
                }
                $lastBackup = $elapsed
            }
        }

        # ---------- final backup before the job timeout ----------
        $elapsed = [int]$clock.Elapsed.TotalSeconds
        if (($elapsed - $lastBackup) -ge $finalSkipIfRecentSec) {
            if ($debug) { Write-Host "[$(Get-Date -Format 'HH:mm:ss')] Final backup (running $([math]::Round($elapsed / 60))min)..." }
            if (-not $debug) { Write-Host "Running final packaging step..." }
            try {
                & $scriptPath -WebDavUrl $env:WEBDAV_URL -WebDavUser $env:WEBDAV_USER -WebDavPassword $env:WEBDAV_PASSWORD
                $lastBackupFailed = $false
                if ($debug) { Write-Host "[$(Get-Date -Format 'HH:mm:ss')] Final backup done" }
            }
            catch {
                $lastBackupFailed = $true
                Write-Warning "Final backup failed: $($_.Exception.Message)"
            }
        }
        elseif ($debug) {
            Write-Host "Final backup skipped: last backup started $([math]::Round(($elapsed - $lastBackup) / 60))min ago"
        }

        if ($lastBackupFailed) {
            throw 'Session finished, but the latest backup failed; see the backup warning above'
        }
        if (-not $debug) { Write-Host "Pipeline completed successfully" }
        if ($debug) { Write-Host "Session finished" }
        exit 0
